# 어드민 로그인 (1차는 이 값과 맞는지만 확인해요. Vercel 환경변수에도 같은 이름으로 넣어 주세요)
ADMIN_ID=admin
ADMIN_PASSWORD=change-me
# 로그인 쿠키 서명용 긴 임의 문자열(비우면 ADMIN_PASSWORD로 서명해요)
ADMIN_SESSION_SECRET=

# 네이버 예약 메일 받기: Gmail Apps Script가 x-soj-secret 헤더로 보내는 값. 긴 임의 문자열로 정해 주세요
NAVER_MAIL_SECRET=

# Supabase (서버에서만 써요. 비밀 키는 브라우저로 보내지 않아요)
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys의 secret key(sb_secret_…) 또는 service_role 키
SUPABASE_SECRET_KEY=
